---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base
  title="Contact · Start a forge with Giedi, Onchain data, Dune dashboards, research"
  description="Talk to Giedi about your protocol, DAO or onchain project. Dune Analytics dashboards, tokenomics analysis, onchain research and custom data pipelines. We reply in less than 48 hours."
  keywords="contact giedi, dune analytics agency contact, onchain data agency, hire dune wizard, blockchain data consulting, crypto dashboard agency"
>

  <Nav />

  <section class="contact">
    <div class="chapter-tag">
      FORGE ORDER <span class="sep">·</span> <span class="state">OPEN</span>
    </div>
    <h2 class="panel-title">Start a forge.</h2>
    <p class="lead">
      Tell us about your protocol and what you want to see in onchain data.
      We will read every message. Expect an answer in less than 48 hours.
    </p>

    <ContactForm />
  </section>

  <Footer />
</Base>

<style>
  .contact {
    padding: 36px 4px 56px;
  }
</style>
