---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base title="Contact · Giedi">
  <Nav />

  <section class="contact">
    <div class="chapter-tag">
      FORGE ORDER <span class="sep">·</span> <span class="state">OPEN</span>
    </div>
    <h2 class="panel-title">Start a forge.</h2>
    <p class="lead">
      Tell us about your protocol and what you want to see in onchain data.
      We will read every message. Expect an answer in less than 48 hours.
    </p>

    <ContactForm />
  </section>

  <Footer />
</Base>

<style>
  .contact {
    padding: 36px 4px 56px;
    border-bottom: 1px dashed var(--line);
  }
</style>
