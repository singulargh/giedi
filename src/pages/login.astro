---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
---

<Base
  title="Sign In · Giedi"
  description="Sign in to your Giedi account to manage your X bot projects."
  keywords="giedi login, giedi sign in, x bot dashboard"
>
  <Nav />

  <section class="login-section">
    <div class="login-box">
      <div class="chapter-tag">
        FORGE ACCESS <span class="sep">·</span> <span class="state">SECURE</span>
      </div>
      <h2 class="panel-title">Sign in.</h2>

      <!-- OAuth block -->
      <div class="oauth-row">
        <button class="btn primary oauth-btn" id="btn-x" type="button" disabled>
          CONTINUE WITH <span class="xi oauth-xi">X</span>
          <span class="badge">SOON</span>
        </button>
      </div>

      <div class="divider">
        <span class="d-line"></span>
        <span class="d-label">OR</span>
        <span class="d-line"></span>
      </div>

      <!-- Email / password form -->
      <form class="login-form" id="login-form" novalidate>
        <div class="field">
          <label class="field-label" for="le">EMAIL</label>
          <input
            type="email"
            id="le"
            class="field-input"
            placeholder="your@email.com"
            autocomplete="email"
            required
          />
        </div>
        <div class="field">
          <label class="field-label" for="lp">PASSWORD</label>
          <input
            type="password"
            id="lp"
            class="field-input"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
        </div>
        <div class="field-err" id="login-err"></div>
        <div class="form-foot">
          <button type="submit" class="btn primary" id="login-submit">LOG IN →</button>
          <a href="#" class="forgot">Forgot password?</a>
        </div>
      </form>

      <div class="login-sub">
        New here? <a href="/start">Start a forge →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .login-section {
    min-height: 72vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 8px 4px 64px;
  }

  .login-box {
    width: 100%;
    max-width: 400px;
  }

  /* OAuth */
  .oauth-row { margin-bottom: 20px; }
  .oauth-btn {
    width: 100%;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    position: relative;
  }
  .oauth-btn:disabled { opacity: 0.5; cursor: default; }
  /* StarCrush X inside the button — bump size to match the label caps */
  .oauth-xi { font-size: 1.15em; line-height: 1; vertical-align: -0.05em; }
  .badge {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    border: 1px solid var(--line);
    padding: 2px 5px;
  }

  /* Divider */
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0;
    color: var(--ink-mute);
    font-size: 10px;
    letter-spacing: 3px;
  }
  .d-line { flex: 1; height: 1px; background: var(--line); }

  /* Fields */
  .field { margin-bottom: 18px; }
  .field-label {
    display: block;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    margin-bottom: 7px;
  }
  .field-input {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    font-family: "JetBrains Mono", monospace;
    font-size: 15px;
    padding: 7px 0 11px;
    outline: none;
    transition: border-color 0.2s;
  }
  .field-input::placeholder { color: var(--ink-mute); }
  .field-input:focus { border-bottom-color: var(--ink); }

  /* Error */
  .field-err {
    min-height: 16px;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--hi);
    margin-top: -8px;
    margin-bottom: 8px;
  }

  /* Footer row */
  .form-foot {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }
  .forgot {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--ink-mute);
  }
  .forgot:hover { color: var(--ink); }

  /* Sub text */
  .login-sub {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--ink-mute);
    text-align: center;
  }
  .login-sub a { color: var(--ink-dim); }
  .login-sub a:hover { color: var(--hi); }
</style>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errEl = document.getElementById("login-err") as HTMLElement;
  const btn = document.getElementById("login-submit") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.textContent = "";

    const email = (document.getElementById("le") as HTMLInputElement).value.trim();
    const pass  = (document.getElementById("lp") as HTMLInputElement).value;

    if (!email || !pass) {
      errEl.textContent = "Please fill in all fields.";
      return;
    }

    btn.disabled = true;
    btn.textContent = "SIGNING IN…";

    // Auth not yet implemented — Supabase integration coming soon
    await new Promise(r => setTimeout(r, 800));
    errEl.textContent = "Authentication coming soon. Email hi@giedi.xyz to get early access.";
    btn.disabled = false;
    btn.textContent = "LOG IN →";
  });
</script>
