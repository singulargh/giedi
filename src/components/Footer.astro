---
import XIcon from "./XIcon.astro";
import DuneIcon from "./DuneIcon.astro";
const year = new Date().getFullYear();
---

<div class="footer-socials" aria-label="Social links">
  <a
    href="https://dune.com/giedixyz"
    target="_blank"
    rel="noopener"
    class="footer-x"
    aria-label="Dune"
  >
    <DuneIcon />
  </a>
  <a
    href="https://x.com/giedixyz"
    target="_blank"
    rel="noopener"
    class="footer-x"
    aria-label="X"
  >
    <XIcon />
  </a>
</div>

<footer class="footer">
  <div class="col">
    <h4>Contact</h4>
    <a href="mailto:hi@giedi.xyz">HI@GIEDI.XYZ</a>
    <a href="/contact">START A FORGE</a>
    <a href="#top">BACK TO THE TOP</a>
  </div>
  <div class="col">
    <h4>The Guild</h4>
    <a href="#">ALL RIGHTS RESERVED</a>
    <a href="#">GIEDI · {year}</a>
  </div>
</footer>

<div class="wordmark" aria-hidden="true">GIEDI</div>

<style>
  /* Row of social icons centered above the two footer columns. */
  .footer-socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
    padding: 18px 0 6px;
    border-top: 1px dashed var(--line);
    margin-top: 24px;
  }
  .footer-socials .footer-x {
    padding: 6px;
  }
  .footer-x {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
  }
  .footer-socials .footer-x :global(svg) {
    width: 18px;
    height: 18px;
  }
  .footer-x :global(svg) {
    width: 11px;
    height: 11px;
    display: block;
    color: var(--ink-dim);
  }
  .footer-x:hover :global(svg) { color: var(--hi); }
</style>
