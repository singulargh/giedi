---
import HalftoneScene from "./HalftoneScene.astro";
---

<header class="hero">
  <div class="hero-top">
    <div class="hero-copy">
      <h1 class="hero-title">Giedi</h1>
      <p class="forge-tag">THE ONCHAIN BOT FORGE</p>
      <p class="forge-line">
        <span class="xi">X</span> bots that read the chain,<br />
        forged in iron, deployed onchain.
      </p>
    </div>
    <div class="hero-showpiece">
      <HalftoneScene kind="xlogo" size="lg" />
    </div>
  </div>
</header>
