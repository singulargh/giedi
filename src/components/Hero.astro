---
import HalftoneScene from "./HalftoneScene.astro";
---

<header class="hero">
  <div class="hero-top">
    <div class="hero-copy">
      <h1 class="hero-title">Giedi</h1>
      <p class="forge-tag">THE ONCHAIN DATA FORGE</p>
      <p class="forge-line">
        We forge dashboards, reports &amp; data infra<br />
        on the raw rock of the chain.
      </p>
    </div>
    <div class="hero-showpiece">
      <HalftoneScene kind="crystal" size="lg" />
      <HalftoneScene kind="solana" size="lg" />
    </div>
  </div>
</header>
