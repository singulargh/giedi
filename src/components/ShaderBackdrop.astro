---
// Full-viewport WebGL backdrop.
// A domain-warped fractal-noise fragment shader rendered as flowing halftone
// stripes — molten iron / liquid metal, matching the forge narrative.
// Raw WebGL, no libraries, ~1 draw call per frame.
---

<canvas id="shader-bg" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("shader-bg") as HTMLCanvasElement | null;
  if (canvas) {
    const gl =
      (canvas.getContext("webgl", {
        alpha: true,
        antialias: false,
        depth: false,
        stencil: false,
        premultipliedAlpha: true,
      }) as WebGLRenderingContext | null) ||
      (canvas.getContext("experimental-webgl") as WebGLRenderingContext | null);

    if (gl) {
      const VS = `
        attribute vec2 a_pos;
        void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
      `;

      // Fragment shader:
      //  · fBm noise with domain warping → organic curves
      //  · posterized into halftone stripes
      //  · warm ember glow that follows the cursor
      //  · transparent where the field is "cold" so black bg shows through
      // Pick highp only if the device really supports it; otherwise mediump.
      // Some mobile GPUs (older PowerVR / Mali) silently fall back to mediump
      // in fragment shaders, which produces banding/block artifacts on our
      // fBm + domain-warped noise. Better to know and author conservatively.
      const hpf =
        gl.getShaderPrecisionFormat?.(gl.FRAGMENT_SHADER, gl.HIGH_FLOAT) ?? null;
      const hasHighp = !!hpf && hpf.precision > 0;
      const PRECISION = hasHighp ? "highp" : "mediump";

      const FS = `
        precision ${PRECISION} float;
        uniform vec2  uRes;
        uniform float uTime;
        uniform vec2  uMouse;

        // Classic sin-hash — keeps intermediate values small so mediump
        // fragment shaders on mobile don't lose precision (no p*p terms,
        // no growing domain). Output is in [0,1).
        float hash(vec2 p){
          return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
        }
        float noise(vec2 p){
          vec2 i = floor(p); vec2 f = fract(p);
          float a = hash(i);
          float b = hash(i+vec2(1.,0.));
          float c = hash(i+vec2(0.,1.));
          float d = hash(i+vec2(1.,1.));
          vec2 u = f*f*(3.0-2.0*f);
          return mix(a,b,u.x) + (c-a)*u.y*(1.0-u.x) + (d-b)*u.x*u.y;
        }
        float fbm(vec2 p){
          float v = 0.0; float a = 0.5;
          // 4 octaves instead of 5 — on mobile the 5th octave magnified
          // the noise domain past the safe range for mediump.
          for (int i = 0; i < 4; i++) {
            v += a*noise(p);
            p = p*2.03 + 17.0;
            a *= 0.5;
          }
          return v;
        }

        void main(){
          vec2 uv = gl_FragCoord.xy / uRes.xy;
          vec2 p  = uv * 2.0 - 1.0;
          p.x *= uRes.x / uRes.y;

          float t = uTime * 0.08;

          // Domain warp (Iñigo Quílez style)
          vec2 q = vec2(fbm(p + t), fbm(p + vec2(1.7, 9.2) - t));
          vec2 r = vec2(
            fbm(p + 4.0*q + vec2(1.7, 9.2) + t*0.6),
            fbm(p + 4.0*q + vec2(8.3, 2.8) - t*0.6)
          );
          float f = fbm(p + 3.0*r);

          // Cursor glow (aspect-corrected)
          vec2 mp = uMouse;
          vec2 md = (uv - mp);
          md.x *= uRes.x / uRes.y;
          float mDist = length(md);
          float hot = exp(-mDist * 3.2);

          // Halftone / stripe posterization
          float stripe  = sin(f * 14.0 + uTime * 0.25 + mDist * -4.0);
          float s       = smoothstep(-0.15, 0.15, stripe);
          float edge    = smoothstep(0.4, 0.5, abs(stripe));

          // Coloring — pure grayscale
          vec3 gray  = vec3(0.58);
          vec3 white = vec3(1.0);
          vec3 col   = mix(gray * 0.30, gray * 0.95, s);
          col       += white * hot * 0.35;
          col       += white * edge * hot * 0.15;

          // Vignette — darker toward the edges
          float vig = smoothstep(1.4, 0.35, length((uv-0.5)*vec2(uRes.x/uRes.y, 1.0)));
          col *= vig;

          // Alpha — restrained so text stays readable
          float a = s * 0.11 + hot * 0.20 + edge * 0.03;
          a *= vig;

          gl_FragColor = vec4(col, a);
        }
      `;

      function compile(type: number, src: string) {
        const sh = gl!.createShader(type)!;
        gl!.shaderSource(sh, src);
        gl!.compileShader(sh);
        if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) {
          console.warn(gl!.getShaderInfoLog(sh));
        }
        return sh;
      }

      const prog = gl.createProgram()!;
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VS));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FS));
      gl.linkProgram(prog);
      gl.useProgram(prog);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
        gl.STATIC_DRAW,
      );
      const aPos = gl.getAttribLocation(prog, "a_pos");
      gl.enableVertexAttribArray(aPos);
      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

      gl.enable(gl.BLEND);
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

      const uRes = gl.getUniformLocation(prog, "uRes");
      const uT = gl.getUniformLocation(prog, "uTime");
      const uM = gl.getUniformLocation(prog, "uMouse");

      // Cursor / finger hot spot — smoothed.
      // On desktop we track the mouse via pointermove. On mobile pointermove
      // only fires while a finger is pressed and dragged, so we also listen
      // to touchstart / touchmove (passive so they don't block scroll), and
      // use scroll to drift the light vertically when the user just scrolls
      // without actively touching — so there's always something alive
      // following the user's gesture.
      let tmx = 0.5, tmy = 0.6;
      let mx = tmx, my = tmy;

      function setFromClient(cx: number, cy: number) {
        tmx = cx / window.innerWidth;
        tmy = 1.0 - cy / window.innerHeight;
      }

      window.addEventListener("pointermove", (e) => {
        setFromClient(e.clientX, e.clientY);
      });
      window.addEventListener(
        "touchstart",
        (e) => {
          const t = e.touches[0];
          if (t) setFromClient(t.clientX, t.clientY);
        },
        { passive: true },
      );
      window.addEventListener(
        "touchmove",
        (e) => {
          const t = e.touches[0];
          if (t) setFromClient(t.clientX, t.clientY);
        },
        { passive: true },
      );

      // Scroll-driven drift for mobile: when the user is scrolling the page
      // we may not get pointer/touch events, but we can still animate the
      // light by mapping the scroll position to a vertical sweep in uv
      // space. Keep horizontal position where the last touch landed.
      window.addEventListener(
        "scroll",
        () => {
          const max = Math.max(
            1,
            document.documentElement.scrollHeight - window.innerHeight,
          );
          const ratio = Math.min(1, Math.max(0, window.scrollY / max));
          // Top of the page → light near top of the screen (tmy ~ 0.85);
          // bottom of the page → light near bottom (tmy ~ 0.15).
          tmy = 0.85 - ratio * 0.7;
        },
        { passive: true },
      );

      // On mobile, window.innerHeight changes every time the URL bar
      // slides in/out of view (which happens as you scroll). Resizing
      // the canvas on each of those "fake" height changes causes
      // visible jumps in the noise field. We:
      //  · ignore resize events that are height-only (width unchanged)
      //  · size the canvas to the largest height we've seen so it
      //    always covers even when the URL bar hides.
      let lastW = 0;
      let lockedH = 0;
      function resize(force = false) {
        const w = window.innerWidth;
        const h = window.innerHeight;
        if (!force && w === lastW) return; // ignore scroll-induced resizes
        lastW = w;
        lockedH = Math.max(lockedH, h);
        const dprCap = w < 760 ? 1.25 : 1.75;
        const dpr = Math.min(window.devicePixelRatio || 1, dprCap);
        canvas!.width = Math.floor(w * dpr);
        canvas!.height = Math.floor(lockedH * dpr);
        canvas!.style.width = w + "px";
        canvas!.style.height = lockedH + "px";
        gl!.viewport(0, 0, canvas!.width, canvas!.height);
      }
      resize(true);
      window.addEventListener("resize", () => resize(false));
      window.addEventListener("orientationchange", () => {
        lockedH = 0;
        resize(true);
      });

      let raf = 0;
      const t0 = performance.now();
      function frame(now: number) {
        mx += (tmx - mx) * 0.08;
        my += (tmy - my) * 0.08;
        gl!.uniform2f(uRes, canvas!.width, canvas!.height);
        gl!.uniform1f(uT, (now - t0) * 0.001);
        gl!.uniform2f(uM, mx, my);
        gl!.clearColor(0, 0, 0, 0);
        gl!.clear(gl!.COLOR_BUFFER_BIT);
        gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
        raf = requestAnimationFrame(frame);
      }
      raf = requestAnimationFrame(frame);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(frame);
      });
    }
  }
</script>

<style>
  #shader-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    /* Use the largest of the visual / dynamic / classic viewport heights.
       "svh" = small (URL bar visible); "lvh" = large (URL bar hidden).
       "lvh" keeps the canvas covering when the bar retracts, avoiding
       the black band that would otherwise appear on mobile browsers. */
    height: 100lvh;
    min-height: 100vh;
    z-index: 0;
    pointer-events: none;
    display: block;
    background: #000;
  }
</style>
