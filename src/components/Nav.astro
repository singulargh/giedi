---
import XIcon from "./XIcon.astro";
import DuneIcon from "./DuneIcon.astro";

const links = [
  { href: "/work", label: "WORK" },
  { href: "/contact", label: "CONTACT" },
];
---

<nav class="nav">
  <a href="/" class="brand" aria-label="Giedi home">
    <span class="brand-g">G</span>
  </a>
  <div class="nav-links">
    {
      links.map((l) => (
        <a
          href={l.href}
          {...(l.external ? { target: "_blank", rel: "noopener" } : {})}
        >
          {l.label}
        </a>
      ))
    }
    <a
      href="https://dune.com/giedixyz"
      target="_blank"
      rel="noopener"
      class="nav-icon"
      aria-label="Dune"
    >
      <DuneIcon />
    </a>
    <a
      href="https://x.com/giedixyz"
      target="_blank"
      rel="noopener"
      class="nav-icon"
      aria-label="X / Twitter"
    >
      <XIcon />
    </a>
  </div>
</nav>

<style>
  /* Match cap-height of the surrounding text, not full em-box.
     A capital "W" only occupies ~0.7em, while an SVG glyph fills the full
     viewBox — so matching to 1em makes icons visually taller than letters. */
  .nav-icon { padding: 4px 8px; display: inline-flex; align-items: center; }
  .nav-icon :global(svg) {
    width: 0.82em;
    height: 0.82em;
    display: block;
  }

  /* Mobile: same horizontal layout as desktop — brand left, links right,
     same gap/padding as desktop so the spacing feels consistent. We just
     shrink the logo a touch so everything fits on one row. */
  @media (max-width: 640px) {
    .nav-links {
      flex-wrap: nowrap;
    }
    .brand-g {
      font-size: 36px;
    }
  }
</style>
