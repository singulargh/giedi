---
import XIcon from "./XIcon.astro";

const links = [
  { href: "/work",  label: "WORK" },
  { href: "/start", label: "START A BOT" },
];
---

<nav class="nav">
  <a href="/" class="brand" aria-label="Giedi home">
    <span class="brand-g">G</span>
  </a>
  <div class="nav-links">
    {links.map(l => <a href={l.href}>{l.label}</a>)}
    <a
      href="https://x.com/giedixyz"
      target="_blank"
      rel="noopener"
      class="nav-icon"
      aria-label="X / Twitter"
    >
      <XIcon />
    </a>
    <a href="/login" class="btn nav-login">LOG IN</a>
  </div>
</nav>

<style>
  /* Fixed pixel size so the icon is always legible regardless of
     the surrounding font-size (nav-links uses 11px = 0.82em ≈ 9px tiny). */
  .nav-icon {
    padding: 4px 10px;
    display: inline-flex;
    align-items: center;
  }
  .nav-icon :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
  }

  .nav-login {
    padding: 6px 14px !important;
    font-size: 10px !important;
    letter-spacing: 2px;
    color: var(--ink) !important;
    border-color: var(--line-strong);
    margin-left: 4px;
  }
  .nav-login:hover {
    background: var(--ink);
    color: #000 !important;
  }

  @media (max-width: 640px) {
    .nav-links  { flex-wrap: nowrap; }
    .brand-g    { font-size: 36px; }
    /* Bigger tap target and icon on mobile */
    .nav-icon   { padding: 4px 12px; }
    .nav-icon :global(svg) { width: 22px; height: 22px; }
  }
</style>
