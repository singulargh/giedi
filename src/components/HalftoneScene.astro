---
// Reusable 3D scene rendered with a halftone post-process.
// Procedural geometry — no model files.
export interface Props {
  kind: "anvil" | "hammer" | "rock" | "crystal" | "gear" | "solana" | "xlogo";
  size?: "sm" | "md" | "lg";
  label?: string;
  class?: string;
}
const { kind, size = "md", label, class: className = "" } = Astro.props;
---

<div class={`halftone-stage ${size} ${className}`} data-kind={kind}>
  <canvas class="halftone-canvas"></canvas>
  {label && <div class="halftone-label">{label}</div>}
</div>

<style>
  .halftone-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
    background: transparent;
  }
  .halftone-stage.sm { max-width: 360px; }
  .halftone-stage.md { max-width: 560px; }
  .halftone-stage.lg { max-width: 900px; }
  .halftone-canvas {
    /* three.js sets inline width/height on resize; keep a fallback so the
       canvas still fills the stage before JS has booted. */
    width: 100%;
    height: 100%;
    display: block;
    max-width: 100%;
  }
  .halftone-label {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-family: "StarCrush", monospace;
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--ink);
    pointer-events: none;
    text-shadow: 0 0 8px #000, 0 0 2px #000;
  }
</style>

<script>
  import * as THREE from "three";
  import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/addons/postprocessing/RenderPass.js";
  import { ShaderPass } from "three/addons/postprocessing/ShaderPass.js";

  // ——— Halftone post-process shader ———
  // Monochrome dot screen. Dot size scales with per-pixel luminance.
  const HalftoneShader = {
    uniforms: {
      tDiffuse: { value: null as any },
      uResolution: { value: new THREE.Vector2(1, 1) },
      uDotSize: { value: 5.0 },
    },
    vertexShader: `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      uniform sampler2D tDiffuse;
      uniform vec2  uResolution;
      uniform float uDotSize;
      varying vec2  vUv;

      void main() {
        vec4 c = texture2D(tDiffuse, vUv);
        if (c.a < 0.02) { gl_FragColor = vec4(0.0); return; }

        float lum = dot(c.rgb, vec3(0.299, 0.587, 0.114));

        vec2 pixel = vUv * uResolution;
        vec2 cell  = mod(pixel, uDotSize) - (uDotSize * 0.5);
        float cellDist = length(cell);

        // Lift shadows so even dark-lit areas still draw visible dots.
        float lm = pow(clamp(lum, 0.0, 1.0), 0.6);
        float radius = (0.12 + lm * 0.48) * uDotSize;
        float d = smoothstep(radius + 0.6, radius - 0.6, cellDist);

        float scan = 0.94 + 0.06 * sin(pixel.y * 0.9);
        float a = clamp(d * 1.15, 0.0, 1.0);
        gl_FragColor = vec4(vec3(d * scan), a);
      }
    `,
  };

  // ——— Procedural geometry builders ———
  function baseMat() {
    return new THREE.MeshStandardMaterial({
      color: 0xd6d6d6,
      metalness: 0.75,
      roughness: 0.38,
      flatShading: true,
    });
  }
  function woodMat() {
    return new THREE.MeshStandardMaterial({
      color: 0x7e6445,
      metalness: 0.0,
      roughness: 0.95,
      flatShading: true,
    });
  }

  function buildAnvil() {
    const g = new THREE.Group();
    const m = baseMat();
    const D = 0.95; // depth (z)

    // ——— Top plate: wide flat slab.
    const topPlate = new THREE.Mesh(new THREE.BoxGeometry(2.00, 0.28, D), m);
    topPlate.position.y = 0.70;
    g.add(topPlate);

    // ——— Horns: four-sided cones extending out from both sides of the top plate.
    function horn(dir: number) {
      const h = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.85, 4), m);
      h.rotation.z = (dir > 0 ? -1 : 1) * Math.PI / 2;
      h.rotation.x = Math.PI / 4; // square cross-section aligned flat
      h.position.set(dir * 1.40, 0.70, 0);
      g.add(h);
    }
    horn(+1);
    horn(-1);

    // ——— Under-plate: narrower lip below the top plate.
    const lip = new THREE.Mesh(new THREE.BoxGeometry(1.55, 0.14, D * 0.9), m);
    lip.position.y = 0.48;
    g.add(lip);

    // ——— Neck: narrow waist connecting top to base.
    const neck = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.55, D * 0.75), m);
    neck.position.y = 0.12;
    g.add(neck);

    // ——— Base crown: slight widening before the base.
    const crown = new THREE.Mesh(new THREE.BoxGeometry(1.20, 0.14, D * 0.9), m);
    crown.position.y = -0.22;
    g.add(crown);

    // ——— Base body: wide trapezoidal footing.
    const base = new THREE.Mesh(new THREE.BoxGeometry(1.85, 0.45, D), m);
    base.position.y = -0.52;
    g.add(base);

    // ——— Feet: four small cube feet at each corner of the base.
    const feetY = -0.85;
    const fx = 0.75, fz = D * 0.35;
    [[-1,-1],[1,-1],[-1,1],[1,1]].forEach(([sx, sz]) => {
      const f = new THREE.Mesh(new THREE.BoxGeometry(0.30, 0.16, 0.22), m);
      f.position.set(sx * fx, feetY, sz * fz);
      g.add(f);
    });

    return g;
  }

  function buildHammer() {
    const g = new THREE.Group();
    const m = baseMat();
    const w = woodMat();
    const dark = new THREE.MeshStandardMaterial({
      color: 0x2b2420,
      metalness: 0.0,
      roughness: 1.0,
      flatShading: true,
    });

    // ——— Head: chunky block with chamfered octagonal ends (war-maul style).
    // Octagon profile viewed from the end → extrude along head length.
    const oct = new THREE.Shape();
    const R = 0.46;
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
      const x = Math.cos(a) * R;
      const y = Math.sin(a) * R;
      if (i === 0) oct.moveTo(x, y); else oct.lineTo(x, y);
    }
    oct.closePath();
    const headGeo = new THREE.ExtrudeGeometry(oct, {
      depth: 1.25,
      bevelEnabled: true,
      bevelThickness: 0.07,
      bevelSize: 0.06,
      bevelSegments: 2,
      curveSegments: 2,
    });
    headGeo.translate(0, 0, -0.625);
    headGeo.rotateY(Math.PI / 2); // length along X
    const head = new THREE.Mesh(headGeo, m);
    head.position.y = 0.75;
    g.add(head);

    // Eye band: dark horizontal seam where the handle passes through.
    const eye = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.08, 0.62), dark);
    eye.position.y = 0.75;
    g.add(eye);

    // ——— Handle: short, stout shaft going downward.
    const handlePts = [
      new THREE.Vector2(0.095, -1.35),
      new THREE.Vector2(0.12,  -1.20),
      new THREE.Vector2(0.105, -1.05),
      new THREE.Vector2(0.09,  -0.60),
      new THREE.Vector2(0.09,   0.20),
      new THREE.Vector2(0.11,   0.50),
    ];
    const handle = new THREE.Mesh(new THREE.LatheGeometry(handlePts, 18), w);
    g.add(handle);

    // Leather wraps: three dark rings along the grip.
    for (let i = 0; i < 3; i++) {
      const y = -0.25 - i * 0.32;
      const wrap = new THREE.Mesh(
        new THREE.CylinderGeometry(0.13, 0.13, 0.16, 16),
        dark,
      );
      wrap.position.y = y;
      g.add(wrap);
    }

    // Pommel: rounded knob at the base of the handle.
    const pommel = new THREE.Mesh(
      new THREE.SphereGeometry(0.16, 16, 10),
      m,
    );
    pommel.position.y = -1.38;
    g.add(pommel);

    // Slight tilt for dynamism.
    g.rotation.z = Math.PI * 0.1;
    return g;
  }

  function buildRock() {
    const geo = new THREE.IcosahedronGeometry(1.35, 4);
    const pos = geo.attributes.position as THREE.BufferAttribute;

    // Pseudo-random hash from a 3D point → stable "noise".
    const hash = (x: number, y: number, z: number) => {
      const s = Math.sin(x * 12.9898 + y * 78.233 + z * 37.719) * 43758.5453;
      return s - Math.floor(s);
    };
    const vnoise = (x: number, y: number, z: number) => {
      const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
      const xf = x - xi,         yf = y - yi,         zf = z - zi;
      const sx = xf * xf * (3 - 2 * xf);
      const sy = yf * yf * (3 - 2 * yf);
      const sz = zf * zf * (3 - 2 * zf);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const c000 = hash(xi,     yi,     zi    );
      const c100 = hash(xi + 1, yi,     zi    );
      const c010 = hash(xi,     yi + 1, zi    );
      const c110 = hash(xi + 1, yi + 1, zi    );
      const c001 = hash(xi,     yi,     zi + 1);
      const c101 = hash(xi + 1, yi,     zi + 1);
      const c011 = hash(xi,     yi + 1, zi + 1);
      const c111 = hash(xi + 1, yi + 1, zi + 1);
      return lerp(
        lerp(lerp(c000, c100, sx), lerp(c010, c110, sx), sy),
        lerp(lerp(c001, c101, sx), lerp(c011, c111, sx), sy),
        sz,
      );
    };

    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
      // fBm — big lumps + medium facets + tiny grit
      const n1 = vnoise(x * 1.3 + 2.0, y * 1.3, z * 1.3) - 0.5;
      const n2 = vnoise(x * 3.1, y * 3.1 + 5.0, z * 3.1) - 0.5;
      const n3 = vnoise(x * 7.0, y * 7.0, z * 7.0 + 9.0) - 0.5;
      const displace = n1 * 0.55 + n2 * 0.28 + n3 * 0.12;
      // Direction from center so it stays rock-shaped (not a puffed sphere).
      const len = Math.sqrt(x * x + y * y + z * z) || 1;
      const nx = x / len, ny = y / len, nz = z / len;
      const d = displace * 0.55;
      pos.setXYZ(i, x + nx * d, y + ny * d, z + nz * d);
    }
    geo.computeVertexNormals();

    const mat = new THREE.MeshStandardMaterial({
      color: 0xbdbdbd,
      metalness: 0.15,
      roughness: 0.95,
      flatShading: true,
    });
    return new THREE.Mesh(geo, mat);
  }

  function buildCrystal() {
    const g = new THREE.Group();
    const geo = new THREE.OctahedronGeometry(1.25, 0);
    geo.scale(1, 1.45, 1);
    const main = new THREE.Mesh(geo, baseMat());
    g.add(main);
    // ring at equator (etched band)
    const ring = new THREE.Mesh(
      new THREE.TorusGeometry(0.95, 0.035, 6, 32),
      baseMat(),
    );
    ring.rotation.x = Math.PI / 2;
    g.add(ring);
    return g;
  }

  function buildGear() {
    const g = new THREE.Group();
    const m = baseMat();

    const ring = new THREE.Mesh(new THREE.TorusGeometry(1.05, 0.22, 10, 28), m);
    g.add(ring);

    const teeth = 12;
    for (let i = 0; i < teeth; i++) {
      const theta = (i / teeth) * Math.PI * 2;
      const tooth = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.22, 0.42), m);
      tooth.position.set(Math.cos(theta) * 1.3, Math.sin(theta) * 1.3, 0);
      tooth.rotation.z = theta + Math.PI / 2;
      g.add(tooth);
    }

    const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.32, 0.5, 18), m);
    hub.rotation.x = Math.PI / 2;
    g.add(hub);

    for (let i = 0; i < 5; i++) {
      const spoke = new THREE.Mesh(new THREE.BoxGeometry(1.75, 0.12, 0.22), m);
      spoke.rotation.z = (i / 5) * Math.PI * 2;
      g.add(spoke);
    }
    return g;
  }

  function buildSolana() {
    const g = new THREE.Group();
    const m = baseMat();

    // Three slanted parallelogram bars.
    function bar(y: number, flip: boolean) {
      const w = 2.2, h = 0.38, slant = 0.32;
      const s = new THREE.Shape();
      if (!flip) {
        s.moveTo(-w / 2 + slant, -h / 2);
        s.lineTo( w / 2,         -h / 2);
        s.lineTo( w / 2 - slant,  h / 2);
        s.lineTo(-w / 2,          h / 2);
      } else {
        s.moveTo(-w / 2,         -h / 2);
        s.lineTo( w / 2 - slant, -h / 2);
        s.lineTo( w / 2,          h / 2);
        s.lineTo(-w / 2 + slant,  h / 2);
      }
      s.closePath();
      const geo = new THREE.ExtrudeGeometry(s, {
        depth: 0.22,
        bevelEnabled: true,
        bevelThickness: 0.04,
        bevelSize: 0.04,
        bevelSegments: 2,
      });
      geo.translate(0, 0, -0.11);
      const mesh = new THREE.Mesh(geo, m);
      mesh.position.y = y;
      return mesh;
    }
    g.add(bar( 0.70, false));
    g.add(bar( 0.00, true));
    g.add(bar(-0.70, false));
    g.rotation.x = -0.25;
    return g;
  }

  function buildXLogo(): THREE.Object3D {
    const m = baseMat();

    // The official X/Twitter logo SVG (viewBox 0 0 1200 1227) has two subpaths
    // in a single <path d="…Z M…Z"> — the second is the inner diagonal cutout
    // that, via the even-odd fill rule, creates the visible gap between the
    // two crossing strokes.
    //
    // All coordinates normalised to Three.js space:
    //   x = (x_svg - 600) / 600 * 0.95
    //   y = -(y_svg - 613.5) / 600 * 0.95   (SVG Y↓  →  Three.js Y↑)

    // ── 1. Outer shape ──────────────────────────────────────────────────────
    const shape = new THREE.Shape();
    shape.moveTo( 0.181,  0.149);   // center-right crossing
    shape.lineTo( 0.888,  0.972);   // top-right corner outer
    shape.lineTo( 0.721,  0.972);   // top-right corner inner
    shape.lineTo( 0.106,  0.257);   // upper crossing, left side
    shape.lineTo(-0.385,  0.972);   // top-left arm outer
    shape.lineTo(-0.950,  0.972);   // top-left corner
    shape.lineTo(-0.208, -0.108);   // center-left crossing
    shape.lineTo(-0.950, -0.970);   // bottom-left corner
    shape.lineTo(-0.783, -0.970);   // bottom-left inner
    shape.lineTo(-0.134, -0.217);   // lower crossing, right side
    shape.lineTo( 0.384, -0.970);   // bottom-right arm outer
    shape.lineTo( 0.950, -0.970);   // bottom-right corner
    shape.closePath();

    // ── 2. Inner diagonal cutout (the void between the two strokes) ─────────
    // Traced from the second subpath of the official SVG path `d` attribute.
    // Adding it as a hole punches it out of the extrusion, just like even-odd
    // fill does in the flat 2-D icon.
    const hole = new THREE.Path();
    hole.moveTo(-0.049, -0.118);
    hole.lineTo(-0.124, -0.010);
    hole.lineTo(-0.723,  0.846);
    hole.lineTo(-0.466,  0.846);
    hole.lineTo( 0.018,  0.155);
    hole.lineTo( 0.093,  0.047);
    hole.lineTo( 0.721, -0.850);
    hole.lineTo( 0.464, -0.850);
    hole.closePath();
    shape.holes.push(hole);

    const geo = new THREE.ExtrudeGeometry(shape, {
      depth: 0.34,
      bevelEnabled: true,
      bevelThickness: 0.045,
      bevelSize: 0.04,
      bevelSegments: 3,
    });
    geo.translate(0, 0, -0.17);

    return new THREE.Mesh(geo, m);
  }

  function build(kind: string): THREE.Object3D {
    switch (kind) {
      case "anvil":   return buildAnvil();
      case "hammer":  return buildHammer();
      case "rock":    return buildRock();
      case "crystal": return buildCrystal();
      case "gear":    return buildGear();
      case "solana":  return buildSolana();
      case "xlogo":   return buildXLogo();
      default:        return buildRock();
    }
  }

  // ——— Setup one stage ———
  function setupStage(stage: HTMLElement) {
    const canvas = stage.querySelector("canvas") as HTMLCanvasElement;
    const kind = stage.dataset.kind || "rock";

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: "low-power",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(0, 0.2, 5.5);

    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(3, 4, 5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xffffff, 1.1);
    rim.position.set(-4, -1, -3);
    scene.add(rim);
    scene.add(new THREE.AmbientLight(0xffffff, 0.25));

    const obj = build(kind);
    scene.add(obj);

    // Center object + fit camera distance so nothing gets clipped.
    const box = new THREE.Box3().setFromObject(obj);
    const center = new THREE.Vector3();
    const size = new THREE.Vector3();
    box.getCenter(center);
    box.getSize(size);
    obj.position.sub(center);
    const maxDim = Math.max(size.x, size.y, size.z);
    camera.position.y = 0;
    camera.lookAt(0, 0, 0);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const halftone = new ShaderPass(HalftoneShader);
    composer.addPass(halftone);

    const dotSize =
      kind === "anvil" || kind === "hammer" ? 4.0 :
      kind === "gear"   ? 4.5 :
      kind === "xlogo"  ? 3.8 :
      5.5;
    halftone.uniforms.uDotSize.value = dotSize;

    let lastW = 0, lastH = 0;
    function resize() {
      const r = stage.getBoundingClientRect();
      const w = Math.max(1, Math.round(r.width));
      const h = Math.max(1, Math.round(r.height));
      if (w === lastW && h === lastH) return;
      lastW = w;
      lastH = h;

      // updateStyle: true so three.js also writes canvas.style.width/height
      // and the displayed size matches the new stage dimensions (not just
      // the internal drawing buffer).
      renderer.setSize(w, h, true);
      composer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();

      // Re-fit the camera distance every resize so the object stays
      // fully in frame regardless of the stage's current aspect ratio.
      const fovV = (camera.fov * Math.PI) / 180;
      const fitV = (maxDim * 0.5) / Math.tan(fovV / 2);
      const fitH = fitV / Math.max(0.0001, camera.aspect);
      camera.position.z = Math.max(fitV, fitH) * 1.35;

      const dpr = renderer.getPixelRatio();
      halftone.uniforms.uResolution.value.set(w * dpr, h * dpr);
    }
    resize();

    // Listen to both window resize AND the stage's own size changes.
    // Media queries and flex reflow can resize the stage without the
    // viewport changing at all — ResizeObserver catches those. We defer
    // the first response to the next animation frame so CSS has time to
    // settle before we read getBoundingClientRect.
    window.addEventListener("resize", resize);
    let roPending = false;
    const ro = new ResizeObserver(() => {
      if (roPending) return;
      roPending = true;
      requestAnimationFrame(() => {
        roPending = false;
        resize();
      });
    });
    ro.observe(stage);

    // Pause when off-screen
    let visible = true;
    const io = new IntersectionObserver(
      (entries) => { visible = entries[0].isIntersecting; },
      { rootMargin: "80px" },
    );
    io.observe(stage);

    // Mild cursor tilt (whole page)
    let mx = 0, my = 0;
    window.addEventListener("pointermove", (e) => {
      mx = (e.clientX / window.innerWidth - 0.5) * 2;
      my = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    let raf = 0;
    function frame(t: number) {
      if (visible) {
        if (kind === "xlogo") {
          // Steady continuous Y spin + gentle tilt on both axes
          obj.rotation.y = t * 0.00075;
          obj.rotation.x = Math.sin(t * 0.00042) * 0.22 + my * -0.18;
          obj.rotation.z = Math.sin(t * 0.00031) * 0.06;
        } else {
          obj.rotation.y = t * 0.00035 + mx * 0.25;
          obj.rotation.x = Math.sin(t * 0.00028) * 0.12 + my * -0.12;
        }
        composer.render();
      }
      raf = requestAnimationFrame(frame);
    }
    raf = requestAnimationFrame(frame);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(frame);
    });
  }

  document.querySelectorAll<HTMLElement>(".halftone-stage").forEach(setupStage);
</script>
