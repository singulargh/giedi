---
import { getCollection } from "astro:content";
import HalftoneScene from "./HalftoneScene.astro";

const stats = [
  { v: "40+", k: "DASHBOARDS FORGED" },
  { v: "15+", k: "CHAINS COVERED" },
  { v: "1B+", k: "ROWS QUERIED / MO" },
  { v: "24/7", k: "DATA UPTIME" },
];

// Real work entries — each dashboard / piece of research / infra job lives as a
// markdown file in src/content/work/. Drafts are hidden; order is newest first.
const entries = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const lead = entries[0];
const rest = entries.slice(1);
---

<section id="work">
  <div class="panel">
    <div class="forge-stack">
      <div class="forge-icon forge-icon-left">
        <HalftoneScene kind="hammer" size="md" />
      </div>

      <div class="forge-copy">
        <div class="chapter-tag">
          THE FORGE <span class="sep">·</span> <span class="state">OPEN</span>
        </div>
        <h2 class="panel-title">The craft, hand-forged.</h2>
        <p class="lead">
          <strong>Giedi</strong> is an onchain data forge. We take raw block data, transactions,
          logs, traces and bridges, and hammer it into <strong>Dune Analytics</strong> dashboards,
          reports and models for any onchain project: protocols, DAOs, chains, wallets, NFT
          collections, tooling and token launches. Metrics that matter, audited queries, clear
          narrative and data that never goes cold, so your team, your community and your
          investors all read the same truth.
        </p>
        <div class="kicker">SERVICES</div>
        <p class="note">
          ▸ Dune dashboards &amp; spellbook contributions<br />
          ▸ Onchain research &amp; written reports<br />
          ▸ Tokenomics &amp; incentive analysis<br />
          ▸ Custom data pipelines, ETL, APIs, webhooks<br />
          ▸ Growth &amp; BD analytics for onchain projects
        </p>
      </div>

      <div class="forge-icon forge-icon-right">
        <HalftoneScene kind="anvil" size="md" />
      </div>
    </div>

    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="stat-val">{s.v}</div>
            <div class="stat-key">{s.k}</div>
          </div>
        ))
      }
    </div>

    {
      entries.length > 0 && (
        <div class="work-list">
          <div class="section-head">
            <div class="label">Forged work</div>
            <div class="pager">
              P[1]/{entries.length}
            </div>
          </div>

          {lead && (
            <a
              class="work-lead"
              href={lead.data.link ?? `#`}
              target={lead.data.link ? "_blank" : undefined}
              rel={lead.data.link ? "noopener" : undefined}
            >
              <div class="work-thumb">
                <span>{lead.data.chain ?? "Giedi"}</span>
              </div>
              <div>
                <div class="work-meta">
                  {lead.data.kind.toUpperCase()}
                  {lead.data.client ? ` · ${lead.data.client}` : ""}
                </div>
                <h4 class="work-title">{lead.data.title}</h4>
                <p class="work-excerpt">{lead.data.excerpt}</p>
              </div>
            </a>
          )}

          {rest.map((p) => (
            <a
              class="work-row"
              href={p.data.link ?? `#`}
              target={p.data.link ? "_blank" : undefined}
              rel={p.data.link ? "noopener" : undefined}
            >
              <div class="rt">{p.data.title}</div>
              <div class="rd">
                <div class="work-meta">
                  {p.data.kind.toUpperCase()}
                  {p.data.client ? ` · ${p.data.client}` : ""}
                  {p.data.chain ? ` · ${p.data.chain}` : ""}
                </div>
                {p.data.excerpt}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Horizontal forge layout: hammer — copy — anvil.
     Icons flank the text on desktop. On mobile they stack top/bottom. */
  .forge-stack {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }
  .forge-icon {
    width: 220px;
    display: flex;
    justify-content: center;
  }
  .forge-icon :global(.halftone-stage) { width: 100%; max-width: 220px; }
  .forge-copy {
    text-align: center;
    min-width: 0;
  }
  .forge-copy .lead { margin-left: auto; margin-right: auto; }
  .forge-copy .kicker { text-align: center; }
  .forge-copy .note { text-align: left; display: inline-block; }

  @media (max-width: 860px) {
    .forge-stack {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .forge-icon { width: 180px; }
  }

  .work-list { margin-top: 26px; }
  .work-list .section-head { margin-top: 10px; }
  .work-lead, .work-row {
    display: grid;
    gap: 24px;
    color: inherit;
  }
  .work-lead {
    grid-template-columns: 300px 1fr;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 18px;
    margin-bottom: 18px;
  }
  .work-row {
    grid-template-columns: 300px 1fr;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line);
  }
  .work-thumb {
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, #0a0a0a, #000);
    aspect-ratio: 16/9;
    display: flex; align-items: center; justify-content: center;
    font-family: "StarCrush", monospace;
    font-size: 44px;
    color: var(--ink);
    letter-spacing: 2px;
    text-align: center;
    padding: 0 8px;
  }
  .work-title { font-size: 15px; margin: 4px 0 8px; color: var(--ink); font-weight: 700; }
  .work-excerpt { color: var(--ink-dim); font-size: 12px; margin: 0; }
  .work-meta {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .work-row .rt {
    font-family: "StarCrush", monospace;
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .work-row .rd { font-size: 12px; color: var(--ink-dim); }
  .work-lead:hover .work-title, .work-row:hover .rt { color: var(--hi); }

  @media (max-width: 860px) {
    .work-lead, .work-row { grid-template-columns: 1fr; }
  }
</style>
