---
import { getCollection } from "astro:content";
import HalftoneScene from "./HalftoneScene.astro";
import XIcon from "./XIcon.astro";

const stats = [
  { v: "50+",  k: "BOTS DEPLOYED" },
  { v: "20+",  k: "CHAINS SUPPORTED" },
  { v: "∞",    k: "TWEETS AUTOMATED" },
  { v: "24/7", k: "ALWAYS ONLINE" },
];

const allEntries = (
  await getCollection("work", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entries = allEntries.slice(0, 5);
const hasMore = allEntries.length > entries.length;
const lead = entries[0];
const rest = entries.slice(1);
---

<section id="work">
  <div class="panel">
    <div class="forge-stack">
      <div class="forge-icon forge-icon-left">
        <HalftoneScene kind="hammer" size="md" />
      </div>

      <div class="forge-copy">
        <div class="chapter-tag">
          THE FORGE <span class="sep">·</span> <span class="state">OPEN</span>
        </div>
        <h2 class="panel-title">The craft, hand-forged.</h2>
        <p class="lead">
          <strong>Giedi</strong> is an onchain bot forge. We build <span class="xi"><XIcon /></span> bots
          that listen to the chain, react to smart contract events, and speak to your
          community in real time. Token launches, protocol activity, NFT mints,
          governance votes — every onchain signal becomes a voice on <span class="xi"><XIcon /></span>. Fully
          automated, fully onchain-native, always on.
        </p>
        <div class="kicker">SERVICES</div>
        <ul class="services">
          <li>Custom <span class="xi"><XIcon /></span> bot development for protocols &amp; DAOs</li>
          <li>Smart contract event listeners &amp; onchain triggers</li>
          <li>Token launch &amp; NFT minting announcement bots</li>
          <li>Community engagement &amp; automated <span class="xi"><XIcon /></span> replies</li>
          <li>Governance, treasury &amp; DAO activity bots</li>
          <li>Multi-chain support, webhooks &amp; custom pipelines</li>
        </ul>
      </div>

      <div class="forge-icon forge-icon-right">
        <HalftoneScene kind="anvil" size="md" />
      </div>
    </div>

    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="stat-val">{s.v}</div>
            <div class="stat-key">{s.k}</div>
          </div>
        ))
      }
    </div>

    {
      entries.length > 0 && (
        <div class="work-list">
          <div class="section-head">
            <div class="label">Forged work</div>
            <a class="pager" href="/work">SEE ALL →</a>
          </div>

          {lead && (
            <a class="work-lead" href={`/work/${lead.slug}`}>
              <div class="work-thumb">
                <span>{lead.data.chain ?? "Giedi"}</span>
              </div>
              <div>
                <div class="work-meta">
                  {lead.data.kind.toUpperCase()}
                  {lead.data.client ? ` · ${lead.data.client}` : ""}
                </div>
                <h4 class="work-title">{lead.data.title}</h4>
                <p class="work-excerpt">{lead.data.excerpt}</p>
              </div>
            </a>
          )}

          {rest.map((p) => (
            <a class="work-row" href={`/work/${p.slug}`}>
              <div class="rt">{p.data.title}</div>
              <div class="rd">
                <div class="work-meta">
                  {p.data.kind.toUpperCase()}
                  {p.data.client ? ` · ${p.data.client}` : ""}
                  {p.data.chain ? ` · ${p.data.chain}` : ""}
                </div>
                {p.data.excerpt}
              </div>
            </a>
          ))}

          {hasMore && (
            <a class="work-all" href="/work">
              See the full archive of {allEntries.length} entries →
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .forge-stack {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
  }
  .forge-icon {
    width: 220px;
    display: flex;
    justify-content: center;
  }
  .forge-icon :global(.halftone-stage) { width: 100%; max-width: 220px; }
  .forge-copy {
    text-align: center;
    min-width: 0;
  }
  .forge-copy .lead { margin-left: auto; margin-right: auto; }
  .forge-copy .kicker { text-align: center; }
  .services {
    list-style: none;
    padding: 0;
    margin: 6px 0 12px;
    color: var(--ink-dim);
    font-size: 12px;
    text-align: center;
  }
  .services li { padding: 3px 0; }

  @media (max-width: 860px) {
    .forge-stack {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .forge-icon { width: 180px; }
  }

  .work-list { margin-top: 26px; }
  .work-list .section-head { margin-top: 10px; }
  .work-lead, .work-row {
    display: grid;
    gap: 24px;
    color: inherit;
    align-items: center;
  }
  .work-lead {
    grid-template-columns: 300px 1fr;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 18px;
    margin-bottom: 18px;
  }
  .work-row {
    grid-template-columns: 300px 1fr;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line);
  }
  .work-thumb {
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, #0a0a0a, #000);
    aspect-ratio: 16/9;
    display: flex; align-items: center; justify-content: center;
    font-family: "StarCrush", monospace;
    font-size: 44px;
    color: var(--ink);
    letter-spacing: 2px;
    text-align: center;
    padding: 0 8px;
  }
  .work-title  { font-size: 15px; margin: 4px 0 8px; color: var(--ink); font-weight: 700; }
  .work-excerpt { color: var(--ink-dim); font-size: 12px; margin: 0; }
  .work-meta {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .work-row .rt {
    font-family: "StarCrush", monospace;
    font-size: 26px;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .work-row .rd { font-size: 12px; color: var(--ink-dim); }
  .work-lead:hover .work-title, .work-row:hover .rt { color: var(--hi); }
  .work-all {
    display: inline-block;
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .work-all:hover { color: var(--hi); }
  a.pager { text-decoration: none; }

  @media (max-width: 860px) {
    .work-lead, .work-row {
      grid-template-columns: 1fr;
      gap: 14px;
      justify-items: start;
      padding: 18px 0;
    }
    .work-thumb {
      width: 100%;
      max-width: 260px;
      aspect-ratio: 4/3;
      font-size: 28px;
    }
    .work-row .rt { font-size: 22px; line-height: 1.1; }
    .work-title   { font-size: 14px; }
  }
</style>
